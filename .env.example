# FireMap Navigator Environment Variables
# Bu faylı .env.local olaraq kopyalayın və öz API key-lərinizi əlavə edin

# NASA FIRMS API Key (https://firms.modaps.eosdis.nasa.gov/api/area/)
NEXT_PUBLIC_FIRMS_API_KEY=your_firms_api_key_here

# Sentinel Hub API (https://www.sentinel-hub.com/)
NEXT_PUBLIC_SENTINEL_CLIENT_ID=your_sentinel_client_id
NEXT_PUBLIC_SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# OpenRouteService API (https://openrouteservice.org/)
NEXT_PUBLIC_ORS_API_KEY=your_openrouteservice_api_key

# Mapbox Access Token (optional, for base maps)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
